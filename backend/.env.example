# Environment variables for Povzetkar Backend

# Database Configuration
DB_KIND=postgresql
DB_HOST=localhost
DB_PORT=5434
DB_USER=<dev-user>
DB_PASS=<dev-password>
DB_NAME=povzetkar

# Test Database Configuration
TEST_DB_USER=<test-user>
TEST_DB_PASS=<test-password>
TEST_DB_NAME=povzetkar_test

# API Keys
YOUTUBE_API_KEY=your_youtube_api_key_here
GOOGLE_API_KEYS=your_google_api_keys_here

# OIDC Authentication (Google)
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=GOCSPX-your-secret
