# Environment variables for Docker Compose

# Development Database (for postgres-dev service)
DB_USER=<dev-user>
DB_PASS=<dev-password>
DB_NAME=povzetkar_dev

# Test Database (for postgres-test service)
TEST_DB_USER=<test-user>
TEST_DB_PASS=<test-password>
TEST_DB_NAME=povzetkar_test

# Quarkus application environment variables (if running outside Docker Compose)
# These are typically picked up by application.properties
DB_KIND=postgresql
DB_HOST=localhost
DB_PORT=5432
