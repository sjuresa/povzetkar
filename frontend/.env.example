# Frontend environment variables

# Base URL for API calls. Empty string means relative paths (proxied by Vite)
# Use this to avoid CORS issues and let Vite handle proxying to http://localhost:8080
VITE_API_BASE_URL=

# Comma-separated list of additional allowed hosts for Vite dev server.
# This is useful when accessing the frontend via Tailscale or other custom domains.
# Default hosts (localhost, 127.0.0.1) are always allowed.
VITE_ALLOWED_HOSTS=www.example.com,192.168.1.100
