{
  "name": "povzetkar-root",
  "version": "0.15.0-SNAPSHOT",
  "private": true,
  "description": "Povzetkar Monorepo Root",
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "cd backend && ../mvnw quarkus:dev",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend && ./mvnw clean install",
    "lint": "npm run lint --prefix frontend",
    "test": "npm-run-all test:backend test:frontend",
    "test:backend": "./mvnw test",
    "test:frontend": "npm run test --prefix frontend -- --run",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "test:full": "npm-run-all test test:e2e",
    "gen:api": "npm run gen:api --prefix frontend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
